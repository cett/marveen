{
  "name": "marveen",
  "version": "1.23.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc && (rm -rf dist/migrations && cp -r src/migrations dist/migrations) && (rm -rf dist/migrations-pg && cp -r src/migrations-pg dist/migrations-pg)",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "remote-enroll": "tsx scripts/remote-access-enroll.ts",
    "dashboard-url": "tsx scripts/dashboard-url.ts",
    "dashboard-user": "tsx scripts/dashboard-user.ts",
    "agent-tokens": "tsx scripts/agent-tokens.ts",
    "install-seed-tenant": "tsx scripts/install-seed-tenant.ts",
    "budget-alert-check": "tsx scripts/budget-alert-check.ts",
    "test": "vitest run",
    "test:guarded": "python3 scripts/vitest-guard.py -- run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:pg-modules": "vitest run --config vitest.pg-modules.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "generate:error-schema": "node scripts/generate-error-schema.mjs",
    "generate:sdk": "npm run generate:error-schema && node scripts/generate-sdk.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "syntax-check": "node --check web/app.js web/sw.js",
    "smoke": "playwright test --config=playwright.config.ts"
  },
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@huggingface/transformers": "^4.3.1",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "entities": "^8.1.0",
    "exceljs": "^4.4.0",
    "js-yaml": "^5.4.3",
    "mammoth": "^1.13.0",
    "pino": "^10.4.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "qs": "^6.16.0",
    "adm-zip": "^0.6.1",
    "uuid": "^11.1.1"
  }
}
