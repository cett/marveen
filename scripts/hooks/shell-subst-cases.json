[
  {"name": "plain command has no body", "command": "rm x", "bodies": []},
  {"name": "double-quoted $()", "command": "echo \"$(rm x)\"", "bodies": ["rm x"]},
  {"name": "double-quoted backtick", "command": "echo \"`rm x`\"", "bodies": ["rm x"]},
  {"name": "double-quoted $() inside text", "command": "echo \"r: $(rm x) done\"", "bodies": ["rm x"]},
  {"name": "bare $()", "command": "echo $(rm x)", "bodies": ["rm x"]},
  {"name": "bare backtick", "command": "echo `rm x`", "bodies": ["rm x"]},
  {"name": "nested double quotes return only the outer body", "command": "echo \"$(echo \"$(rm x)\")\"", "bodies": ["echo \"$(rm x)\""]},
  {"name": "assignment with double-quoted $()", "command": "v=\"$(rm x)\"; echo ok", "bodies": ["rm x"]},
  {"name": "unquoted heredoc expands", "command": "cat <<EOF\n$(rm x)\nEOF\n", "bodies": ["rm x"]},
  {"name": "unquoted heredoc backtick", "command": "cat <<EOF\n`rm x`\nEOF\n", "bodies": ["rm x"]},
  {"name": "single-quoted delimiter is literal", "command": "cat <<'EOF'\n$(rm x)\nEOF\n", "bodies": []},
  {"name": "double-quoted delimiter is literal", "command": "cat <<\"EOF\"\n$(rm x)\nEOF\n", "bodies": []},
  {"name": "backslashed delimiter is literal", "command": "cat <<\\EOF\n$(rm x)\nEOF\n", "bodies": []},
  {"name": "dash heredoc closes on a tab-indented line", "command": "cat <<-EOF\n\t$(rm x)\n\tEOF\necho $(ls)", "bodies": ["rm x", "ls"]},
  {"name": "text after the heredoc closer is command text again", "command": "cat <<EOF\nplain\nEOF\necho $(rm x)", "bodies": ["rm x"]},
  {"name": "two heredocs on one line, second is literal", "command": "cat <<A <<'B'\n$(x)\nA\n$(y)\nB\n", "bodies": ["x"]},
  {"name": "unterminated heredoc runs to the end", "command": "cat <<EOF\n$(rm x)\n", "bodies": ["rm x"]},
  {"name": "heredoc backslash escapes the marker", "command": "cat <<EOF\n\\$(rm x)\nEOF\n", "bodies": []},
  {"name": "here-string is not a heredoc", "command": "cat <<<\"$(rm x)\"", "bodies": ["rm x"]},
  {"name": "process substitution", "command": "diff <(rm x) /dev/null", "bodies": ["rm x"]},
  {"name": "output process substitution", "command": "echo hi | tee >(rm x)", "bodies": ["rm x"]},
  {"name": "single quotes are literal", "command": "echo '$(rm x)'", "bodies": []},
  {"name": "single quote around a backtick is literal", "command": "echo '`rm x`'", "bodies": []},
  {"name": "ANSI-C quote is literal", "command": "echo $'$(rm x)'", "bodies": []},
  {"name": "ANSI-C quote with an escaped quote is read to its end", "command": "echo $'a\\'b $(rm x)' $(ls)", "bodies": ["ls"]},
  {"name": "escaped $( is literal", "command": "echo \\$(rm x)", "bodies": []},
  {"name": "escaped $( inside double quotes is literal", "command": "echo \"\\$(rm x)\"", "bodies": []},
  {"name": "escaped backtick is literal", "command": "echo \\`rm x\\`", "bodies": []},
  {"name": "trailing comment is not run", "command": "echo hi # $(rm x)", "bodies": []},
  {"name": "comment line is not run", "command": "# $(rm x)\necho hi", "bodies": []},
  {"name": "hash inside a word is not a comment", "command": "echo a#$(rm x)", "bodies": ["rm x"]},
  {"name": "hash inside double quotes is not a comment", "command": "echo \"# $(rm x)\"", "bodies": ["rm x"]},
  {"name": "comment after a body is not read", "command": "echo $(ls # )\n)", "bodies": ["ls # )\n"]},
  {"name": "arithmetic expansion", "command": "echo $((1+2))", "bodies": ["(1+2)"]},
  {"name": "substitution inside arithmetic", "command": "echo $(( $(rm x) + 1 ))", "bodies": ["( $(rm x) + 1 )"]},
  {"name": "substitution inside a parameter expansion", "command": "echo ${x:-$(rm y)}", "bodies": ["rm y"]},
  {"name": "two substitutions in order", "command": "echo $(a) \"$(b)\"", "bodies": ["a", "b"]},
  {"name": "empty substitution", "command": "echo $()", "bodies": [""]},
  {"name": "unterminated $() takes the rest", "command": "echo $(rm x", "bodies": ["rm x"]},
  {"name": "unterminated double-quoted $() takes the rest", "command": "echo \"$(rm x", "bodies": ["rm x"]},
  {"name": "unterminated backtick takes the rest", "command": "echo `rm x", "bodies": ["rm x"]},
  {"name": "unterminated single quote hides the rest", "command": "echo 'a $(rm x)", "bodies": []},
  {"name": "backtick body unescapes nested backticks", "command": "echo `echo \\`rm x\\``", "bodies": ["echo `rm x`"]},
  {"name": "backtick body unescapes \\$", "command": "echo `echo \\$(rm x)`", "bodies": ["echo $(rm x)"]},
  {"name": "a quoted paren does not close the body", "command": "echo $(echo \")\" ; rm x)", "bodies": ["echo \")\" ; rm x"]},
  {"name": "a single-quoted paren does not close the body", "command": "echo $(echo ')' ; rm x)", "bodies": ["echo ')' ; rm x"]},
  {"name": "a subshell paren inside the body is balanced", "command": "echo $( (rm x) ; ls )", "bodies": [" (rm x) ; ls "]},
  {"name": "single quote inside double quotes is a character", "command": "echo \"it's $(rm x)\"", "bodies": ["rm x"]},
  {"name": "double quote inside single quotes is a character", "command": "echo '\"' $(rm x)", "bodies": ["rm x"]},
  {"name": "commit message heredoc: the body is the cat, not the message", "command": "git commit -m \"$(cat <<'EOF'\nmsg $(rm x)\nEOF\n)\"", "bodies": ["cat <<'EOF'\nmsg $(rm x)\nEOF\n"]},
  {"name": "a backtick inside a double-quoted substitution body is nested, not top", "command": "echo \"$(echo `rm x`)\"", "bodies": ["echo `rm x`"]},
  {"name": "dollar before a quote is not a substitution", "command": "echo $\"x\" $(ls)", "bodies": ["ls"]},
  {"name": "lone dollar and parens", "command": "echo $ (rm x)", "bodies": []}
]
